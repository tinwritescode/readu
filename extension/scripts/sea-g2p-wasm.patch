diff --color -ruN -x t a/src/wasm.rs b/src/wasm.rs
--- a/src/wasm.rs	1970-01-01 08:00:00
+++ b/src/wasm.rs	2026-10-18 23:09:49
@@ -0,0 +1,39 @@
+//! WebAssembly surface for browsers: the same two stages as the C ABI, with the
+//! dictionary passed in as bytes because a browser has no files to map.
+
+use wasm_bindgen::prelude::*;
+
+use crate::core::dict::PhonemeDict;
+use crate::g2p::G2PEngine;
+use crate::lang::vi::Normalizer;
+
+#[wasm_bindgen]
+pub struct SeaG2p {
+    normalizer: Normalizer,
+    engine: G2PEngine,
+}
+
+#[wasm_bindgen]
+impl SeaG2p {
+    /// Takes the bytes of `sea_g2p.bin`. They are kept for the life of the page and shared by both stages.
+    #[wasm_bindgen(constructor)]
+    pub fn new(dict: Vec<u8>) -> Result<SeaG2p, JsError> {
+        let bytes: &'static [u8] = Box::leak(dict.into_boxed_slice());
+        crate::lang::vi::technical::init_norm_dict_static(bytes);
+        let engine = G2PEngine::from_dict(PhonemeDict::from_static(bytes)?);
+        Ok(SeaG2p { normalizer: Normalizer::new("vi", None), engine })
+    }
+
+    /// Text to phonemes: normalise, then phonemise.
+    pub fn phonemize(&self, text: &str, punc_norm: bool) -> String {
+        if text.is_empty() {
+            return String::new();
+        }
+        self.engine.phonemize(&self.normalizer.normalize(text, punc_norm))
+    }
+
+    /// Normalisation alone.
+    pub fn normalize(&self, text: &str, punc_norm: bool) -> String {
+        self.normalizer.normalize(text, punc_norm)
+    }
+}
